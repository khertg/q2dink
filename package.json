{
  "name": "q2dink",
  "private": true,
  "version": "1.33.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @q2dink/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint apps packages",
    "test:e2e": "npm run test:e2e -w @q2dink/web",
    "test:e2e:ui": "npm run test:e2e:ui -w @q2dink/web"
  },
  "devDependencies": {
    "oxlint": "^1.81.0"
  }
}
