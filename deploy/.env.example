# Copy to deploy/.env and fill in. This file is read by docker-compose.prod.yml.

# The domain whose DNS A record points at this server, e.g. q2dink.example.com.
DOMAIN=

# Choose a long random password (for example: openssl rand -base64 24).
POSTGRES_PASSWORD=

# Optional. A server set up before the app was renamed from Matchup to Q2Dink must set both of these to
# `matchup`, because its existing database was created with that name (see "Upgrading from Matchup" in README.md).
# POSTGRES_USER=q2dink
# POSTGRES_DB=q2dink
# LOG_LEVEL=info

# Optional: voice call-outs through ElevenLabs (see "Voice call-outs" in README.md). Without a key, staff
# devices read call-outs with their own built-in voice.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# RATE_LIMIT_SPEECH_MAX=30

# Only when ports 80/443 are taken on this machine (for example while testing locally).
# HTTP_PORT=80
# HTTPS_PORT=443
