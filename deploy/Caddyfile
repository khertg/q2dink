# Serves the web app and forwards /api to the API. Caddy gets and renews the HTTPS
# certificate by itself when DOMAIN is a real domain pointing at this server.
# DOMAIN=:80 serves plain HTTP on any host name (used for local testing only).
{$DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# HTTPS only from now on for this domain (ignored over plain HTTP).
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
		# Keep this identical to apps/web/csp.ts (a unit test checks it): scripts and everything else only from this site.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		# flush_interval -1 sends the live-board event stream to viewers immediately.
		reverse_proxy api:8787 {
			flush_interval -1
		}
	}

	handle {
		root * /srv

		# Everything revalidates by default. That matters for the HTML shell (also served for routes such as
		# /club/<name>/live), the service worker and the manifest: if they were cached, app updates would never arrive.
		@revalidate not path /assets/*
		header @revalidate Cache-Control "no-cache"

		# Files under /assets have a content hash in their name, so they can be cached for good.
		# (The two rules never overlap, so the order Caddy runs them in does not matter.)
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# Client-side routes such as /club/<name>/live load the app.
		try_files {path} /index.html
		file_server
	}
}
